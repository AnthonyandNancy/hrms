{
  "name": "@hrms/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "openapi:generate": "node scripts/generate-api.mjs",
    "openapi:check": "node scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.21.1",
    "dayjs": "1.11.23",
    "echarts": "5.6.0",
    "element-plus": "2.14.8",
    "pinia": "3.0.4",
    "vue": "3.5.46",
    "vue-router": "4.6.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.12.1",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vitest": "3.2.7",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@10.34.5"
}
