APP_NAME=FactoryHR
APP_ENV=local
APP_TIMEZONE=UTC
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# SPA origins allowed to send credentialed CORS requests (comma-separated).
# Never use "*" with cookie authentication.
# Transient login throttle per username+IP (persistent lockout is separate).
IAM_LOGIN_RATE_LIMIT_PER_MINUTE=5
# Owner decision 2026-11-25: password-only sign-in. Set true to re-enable TOTP/step-up.
IAM_MFA_ENABLED=false
HRMS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: SQLite. Use DB_CONNECTION=mysql for production parity.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=factoryhr
# DB_USERNAME=factoryhr
# DB_PASSWORD=
# MYSQL_ROOT_PASSWORD=


SESSION_DRIVER=database
SESSION_COOKIE=hrms_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
REDIS_QUEUE=default

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=
# Local MinIO parity: AWS_ENDPOINT=http://minio:9000
AWS_ENDPOINT=

# Optional application version shown by /v1/meta and /v1/health
APP_VERSION=1.0.0-reference

VITE_APP_NAME="${APP_NAME}"
