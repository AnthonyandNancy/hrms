{
  "name": "factoryhr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "typecheck": "node scripts/frontend-workspace.mjs typecheck",
    "lint": "node scripts/frontend-workspace.mjs lint",
    "test:unit": "node scripts/frontend-workspace.mjs test:unit",
    "test:e2e": "node scripts/frontend-workspace.mjs test:e2e",
    "actions:check": "node scripts/audit_action_manifest.mjs",
    "page-components:check": "node scripts/audit_page_components.mjs",
    "page-model:check": "node scripts/audit_page_model.mjs",
    "ui-primitives:check": "node scripts/audit_ui_primitives.mjs",
    "copy:check": "node scripts/audit_user_copy.mjs",
    "openapi:lint": "node deploy/scripts/openapi-lint.mjs",
    "openapi:generate": "node scripts/frontend-workspace.mjs openapi:generate",
    "openapi:validate": "redocly lint --config .redocly.yaml docs/openapi/openapi.yaml",
    "openapi:check": "node scripts/frontend-workspace.mjs openapi:check",
    "modules:check": "node scripts/audit_frontend_modules.mjs",
    "v11:gate": "node scripts/v11_production_gate.mjs",
    "baseline:collect": "node scripts/collect_v2_baseline.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.82.0",
    "yaml": "2.9.1"
  }
}
